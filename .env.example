# Database Configuration (PostgreSQL)
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=SmartInventoryDB;Username=postgres;Password=your_postgres_password;

# JWT Authentication Settings
JWT_SECRET=your_super_secret_cryptographic_key_minimum_32_characters_long
JWT_ISSUER=SmartInventoryAPI
JWT_AUDIENCE=SmartInventoryAPIUsers
JWT_EXPIRY_MINUTES=60

# Initial Database Seed Settings
SEED_ADMIN_PASSWORD=your_seed_admin_password
SEED_DEFAULT_USER_PASSWORD=your_seed_user_password