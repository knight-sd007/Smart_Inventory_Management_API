# ===========================================
# Smart Inventory Management API
# Environment Variables (DO NOT COMMIT .env)
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file or real secrets to version control.

# --- Database ---
# SQL Server connection string
DB_CONNECTION_STRING=Server=localhost;Database=SmartInventoryDB;User Id=sa;Password=YourPassword123!;Encrypt=true;TrustServerCertificate=false;

# --- JWT Authentication ---
# Secret key for signing JWT tokens (minimum 32 characters, use a cryptographically secure random string)
JWT_SECRET=replace-with-a-cryptographically-secure-random-string-at-least-32-chars

# JWT token issuer
JWT_ISSUER=SmartInventoryAPI

# JWT token audience
JWT_AUDIENCE=SmartInventoryAPIUsers

# JWT token expiry in minutes
JWT_EXPIRY_MINUTES=60

# --- Seed Data Passwords ---
# ONLY used during initial database seeding. Change after first deployment.
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEFAULT_USER_PASSWORD=ChangeMe123!

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5209